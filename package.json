{
  "name": "shit-code-detector",
  "displayName": "Shit Code Detector",
  "description": "对多语言代码库进行可解释的 0–9 分质量分析",
  "icon": "media/logo.png",
  "version": "0.8.1",
  "publisher": "serendipitylin0731",
  "author": "_serendipity",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/serendipitylin0731/shit-code_detector.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onView:shitCodeDetector.dashboardRight",
    "onCommand:shitCodeDetector.scanWorkspace",
    "onCommand:shitCodeDetector.scanFiles",
    "onCommand:shitCodeDetector.scanRepository",
    "onCommand:shitCodeDetector.setApiKey",
    "onCommand:shitCodeDetector.exportJson"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "shitCodeDetectorRight",
          "title": "Shit Code Detector",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "shitCodeDetectorRight": [
        {
          "id": "shitCodeDetector.dashboardRight",
          "name": "代码评分",
          "type": "webview",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "shitCodeDetector.scanWorkspace",
        "title": "Shit Code Detector: 评分当前项目"
      },
      {
        "command": "shitCodeDetector.scanFiles",
        "title": "Shit Code Detector: 评分当前文件"
      },
      {
        "command": "shitCodeDetector.scanRepository",
        "title": "Shit Code Detector: 评分 HTTPS Git 仓库"
      },
      {
        "command": "shitCodeDetector.setApiKey",
        "title": "Shit Code Detector: 设置 AI API Key"
      },
      {
        "command": "shitCodeDetector.exportJson",
        "title": "Shit Code Detector: 导出 JSON 报告"
      }
    ],
    "configuration": {
      "title": "Shit Code Detector",
      "properties": {
        "shitCodeDetector.ai.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "AI 服务的 HTTPS 根地址；使用 DeepSeek 时保持默认值即可，不要添加 /chat/completions。"
        },
        "shitCodeDetector.ai.model": {
          "type": "string",
          "default": "deepseek-flash",
          "description": "AI 模型 ID。默认使用 DeepSeek 当前 Flash 名称；其他兼容服务可填写自己的模型 ID。"
        },
        "shitCodeDetector.ai.maxCharsPerRequest": {
          "type": "integer",
          "default": 12000,
          "minimum": 1000,
          "maximum": 50000,
          "description": "每次 AI 文件请求最多包含多少代码字符（默认 12000）。文件过长会自动连续分片；所有有效代码都会送审，这不是总量上限。较小的值会增加 API 请求次数。"
        },
        "shitCodeDetector.maxFileBytes": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "单个代码文件的读取上限，单位字节；默认 0 表示不限制。若设置正数，超限文件会跳过并在报告中计数，无法声称完整覆盖。"
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/clean-dist.js && tsc -p . && node scripts/copy-parser.js",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "test:ai": "npm run compile && node scripts/test-ai.js",
    "docs:rubric": "npm run compile && node scripts/generate-ai-rubric.js",
    "fixtures": "npm run compile && node scripts/create-fixtures.js",
    "package": "npm run compile && node scripts/package.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1"
  },
  "dependencies": {
    "ignore": "^7.0.14",
    "undici": "^7.30.1"
  }
}
